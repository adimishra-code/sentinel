# =============================================================================
# Sentinel - Root Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_in_production
MONGO_DB=sentinel

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Used for session cache and rate limiting
REDIS_PASSWORD=changeme_in_production

# -----------------------------------------------------------------------------
# Qdrant Vector Store
# -----------------------------------------------------------------------------
# Leave empty for local (no auth), set for Qdrant Cloud
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Backend (Express/Node)
# -----------------------------------------------------------------------------
BACKEND_PORT=3000

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Worker URL (Python AI service)
WORKER_URL=http://localhost:8000

# Backend URL (used by worker for CORS)
BACKEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SMTP Email (Nodemailer)
# Optional — in-app notifications work without email configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Sentinel
SMTP_FROM_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_APP_NAME=Sentinel

# -----------------------------------------------------------------------------
# Frontend port (for docker-compose)
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Worker (Python AI Service)
# -----------------------------------------------------------------------------
WORKER_PORT=8000
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash-exp

# Gemini API key — get from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# Production (Render / Docker)
# -----------------------------------------------------------------------------
# API_URL=/api/v1          # Used by frontend in production (relative path)
# WS_URL=                  # WebSocket URL if different from API
