# =============================================================================
# Sentinel - Root Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1

# -----------------------------------------------------------------------------
# MongoDB (required)
# -----------------------------------------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_in_production
MONGO_DB=sentinel
# Full Mongo connection string (overrides the parts above if set)
MONGO_URI=mongodb://admin:changeme@localhost:27017/sentinel?authSource=admin

# -----------------------------------------------------------------------------
# Redis (required for caching, rate limiting, BullMQ queues)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=changeme_in_production
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Qdrant Vector Store
# -----------------------------------------------------------------------------
# Leave QDRANT_API_KEY empty for local Qdrant without auth; set for Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Backend (Express/Node)
# -----------------------------------------------------------------------------
BACKEND_PORT=3000

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Both secrets MUST be at least 32 characters (enforced at startup).
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma-separated allowed origins (no wildcards in production)
CORS_ORIGIN=http://localhost:5173

# Rate limiting (global window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Worker URL (Python AI service) - backend calls worker over this
WORKER_URL=http://localhost:8000

# Backend URL (used by worker for CORS)
BACKEND_URL=http://localhost:3000

# Shared secret for backend-to-worker service authentication (enforced at startup, min 32 chars)
WORKER_SHARED_SECRET=your-shared-backend-worker-secret-min-32-chars
# Encryption key for at-rest secrets (TOTP secrets, etc.) - must be >= 32 chars
ENCRYPTION_KEY=your-encryption-key-min-32-chars-change-in-production

# -----------------------------------------------------------------------------
# SMTP Email (Nodemailer)
# Optional — in-app notifications work without email configuration.
# If SMTP_HOST is unset, email is skipped and errors are logged to console.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Sentinel
SMTP_FROM_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_APP_NAME=Sentinel

# Frontend port (for docker-compose)
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Worker (Python AI Service)
# -----------------------------------------------------------------------------
WORKER_PORT=8000
MODEL_PROVIDER=gemini
# Move to the current stable Gemini Flash model after checking Google's docs.
# Do not use experimental -exp models in production.
MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Production (Render / Docker) - uncomment and set in production
# -----------------------------------------------------------------------------
# API_URL=/api/v1          # Used by frontend in production (relative path)
# WS_URL=                  # WebSocket URL if different from API
