# =============================================================================
# Sentinel Worker - Python AI Service Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to git!
# =============================================================================

# Service
WORKER_PORT=8000
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://admin:changeme@localhost:27017/sentinel?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI / Gemini
MODEL_PROVIDER=gemini
# Use the current stable Gemini Flash model. Do not use experimental -exp models in production.
MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_API_KEY=your-gemini-api-key-here

# Backend (for internal calls / shared secret validation)
BACKEND_URL=http://backend:3000
# Must match backend WORKER_SHARED_SECRET (>= 32 chars)
WORKER_SHARED_SECRET=your-shared-backend-worker-secret-min-32-chars

# CORS - only allow backend service in production
CORS_ORIGINS=http://backend:3000,http://localhost:3000

# Observability
SENTRY_DSN=
