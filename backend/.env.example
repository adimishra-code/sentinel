# =============================================================================
# Sentinel Backend - Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to git!
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_VERSION=v1

# Database (required)
MONGO_URI=mongodb://admin:changeme@localhost:27017/sentinel?authSource=admin

# Redis (required)
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Authentication (JWT_SECRET and JWT_REFRESH_SECRET must be >= 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Worker Service
WORKER_URL=http://localhost:8000
BACKEND_URL=http://localhost:3000
# Shared secret for backend-to-worker service auth (must be >= 32 chars)
WORKER_SHARED_SECRET=your-shared-backend-worker-secret-min-32-chars
# Encryption key for at-rest secrets (TOTP secrets, etc.) - must be >= 32 chars
ENCRYPTION_KEY=your-encryption-key-min-32-chars-change-in-production

# SMTP Email (optional - email skipped if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Sentinel
SMTP_FROM_EMAIL=your@email.com

# Observability
SENTRY_DSN=
